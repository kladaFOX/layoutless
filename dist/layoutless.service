[Unit]
Description=layoutless: us/ru keyboard layout correction
Documentation=https://github.com/kladaFOX/layoutless
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/layoutless
# Exits when Hyprland goes away; the restart picks up the new instance.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
